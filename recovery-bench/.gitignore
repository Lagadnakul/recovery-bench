# deps
node_modules/
packages/*/node_modules/

# build output
dist/
packages/dashboard/dist/

# runtime artifacts — regenerable, never committed
data/cache/
data/runs/
# Per-machine spend state, not a derived result. Committing it would make a
# fresh clone appear to have already spent this machine's diagnostic tokens,
# and every run would conflict. The derived outputs below ARE committed,
# because they cannot be rebuilt without the gitignored archive.
data/ledger.jsonl
# Sweep results WERE ignored as per-run experimental output, on the reasoning that
# the committed record of the original study is replay_rows.json. That reasoning
# held while no sweep had ever run. It stopped holding on 25 Oct 2026, when a5
# produced 720 rows over 127.8 minutes and 8.608M tokens of free-tier quota.
#
# Those rows are the paper's PRIMARY DATASET, not a derived artifact: they cannot
# be regenerated without spending the quota again, and the quota is finite. A
# primary dataset living in one untracked file on one machine is exactly how
# c8872d07 came to be a dangling commit. So it is tracked.
#
# Verified before committing: zero key-shaped strings, and none of the seven real
# key values from .env.local appear anywhere in it. Re-check with the same two
# greps before committing any future sweep output.
#
# data/sweep_rows.jsonl — deliberately NOT ignored

# Archived provenance payload. Every file in it already lives upstream at
# Lagadnakul/Dissertation @ c8872d070fb0b098394796dfbc68bcf67c3bd957, so the copy
# is convenience, not the record. MANIFEST.md and SHA256SUMS ARE committed —
# they pin what the copy should contain.
archive/legacy_runs/
archive/legacy_predictions/
archive/legacy_aggregates/
archive/legacy_code/

# secrets — keys live in .env.local at the project root and are referenced by
# NAME only, via api_key_env in configs/. Never commit a key.
.env
.env.local
.env.*.local

# OS
.DS_Store
