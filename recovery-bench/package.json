{
  "name": "recovery-bench",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "audit-legacy": "bun scripts/audit_legacy_patches.ts",
    "doctor": "bun --env-file ../.env.local packages/pipeline/cli.ts doctor",
    "doctor:live": "bun --env-file ../.env.local packages/pipeline/cli.ts doctor --live",
    "export-dataset": "bun scripts/export_dataset.ts",
    "replay": "bun packages/pipeline/cli.ts replay",
    "ccos": "bun packages/pipeline/cli.ts ccos",
    "power": "bun packages/pipeline/cli.ts power",
    "report": "bun packages/pipeline/cli.ts report",
    "sweep": "bun --env-file ../.env.local packages/pipeline/cli.ts sweep",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "bun scripts/verify.ts",
    "verify:fast": "bun scripts/verify.ts --fast",
    "try": "bun --env-file ../.env.local packages/pipeline/cli.ts try",
    "warm-cache": "bun packages/pipeline/cli.ts warm-cache"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
