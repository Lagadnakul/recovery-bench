# Names only. Copy to ../.env.local (project root) and fill in values there.
# Nothing in this repository ever reads a key value except the provider adapter,
# and configs/ reference keys by NAME via api_key_env.

# NVIDIA NIM — build.nvidia.com. A list enables the key pool (D3).
NVIDIA_KEY_1=
NVIDIA_KEY_2=
NVIDIA_KEY_3=

# QwenCloud MaaS — maas.qwencloudapi.com/compatible-mode/v1
qwen_api_key=

# Google Gemini — required for A1, the replication arm (Nakul's original model)
gemini_api_key=
